{% extends "base.html.jinja" %}

{% set status_colors = {"Normal": "text-success", "MaybeReady": "text-warn", "Offline": "text-danger", "ServiceError": "text-danger"} %}
{% set status_labels = {"Normal": "Normal", "MaybeReady": "Maybe ready", "Offline": "Offline", "ServiceError": "Service error"} %}

{% block content %}
  <div id="overview" class="space-y-8" hx-get="/dashboard/" hx-trigger="every 5s" hx-target="this" hx-swap="outerHTML">
    <section>
      <h2 class="mb-3 text-sm font-semibold">Summary</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-4">
        <div class="rounded-card border border-line bg-surface p-4">
          <h3 class="text-sm font-medium">Substituters</h3>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-semibold">{{ model.summary.available_substituters }}</span>
            <span class="text-sm text-muted">/ {{ model.summary.total_substituters }} available</span>
          </div>
        </div>
        <div class="rounded-card border border-line bg-surface p-4">
          <h3 class="text-sm font-medium">Transferring</h3>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-semibold">{{ model.summary.transferring_nar_files }}</span>
            <span class="text-sm text-muted">in progress</span>
          </div>
        </div>
        <div class="rounded-card border border-line bg-surface p-4">
          <h3 class="text-sm font-medium">NAR info cache</h3>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-semibold">{{ model.summary.nar_info_cache_size }}</span>
            <span class="text-sm text-muted">/ {{ model.summary.nar_info_cache_capacity }}</span>
          </div>
        </div>
        <div class="rounded-card border border-line bg-surface p-4">
          <h3 class="text-sm font-medium">Cache mode</h3>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-semibold">
              {{ "In-memory" if model.summary.cache_mode == "InMemory" else "Persistent" }}
            </span>
          </div>
        </div>
      </div>
    </section>

    <section>
      <h2 class="mb-3 text-sm font-semibold">Substituters</h2>
      <div class="overflow-x-auto rounded-card border border-line bg-surface">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line bg-canvas/50 text-left text-xs font-medium text-subtle">
              <th scope="col" class="px-4 py-2.5 font-medium whitespace-nowrap">URL</th>
              <th scope="col" class="px-4 py-2.5 font-medium whitespace-nowrap">Priority</th>
              <th scope="col" class="px-4 py-2.5 font-medium whitespace-nowrap">Authentication</th>
              <th scope="col" class="px-4 py-2.5 font-medium whitespace-nowrap">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft">
            {% for substituter in model.substituters %}
              <tr class="transition-colors hover:bg-canvas/50">
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="font-mono">{{ substituter.url }}</div>
                  <div class="font-mono text-xs text-subtle">{{ substituter.storage_url }}</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="text-muted">{{ substituter.priority }}</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="text-muted">{{ "Authenticated" if substituter.has_credential else "Public" }}</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="{{ status_colors[substituter.status] }}">{{ status_labels[substituter.status] }}</div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
{% endblock %}
