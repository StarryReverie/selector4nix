<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="htmx-config" content='{"defaultFocusScroll":false,"selfRequestsOnly":true}' />
    <title>selector4nix</title>

    <link rel="stylesheet" href="/dashboard/static/main.css" />
    <script type="module" src="/dashboard/static/main.js" defer></script>
  </head>

  <body class="min-h-screen" hx-boost="true">
    <header class="sticky top-0 z-20 h-14 bg-surface">
      <div class="mx-auto flex h-full max-w-6xl items-center gap-6 px-4">
        <a href="/dashboard/" class="font-sans text-lg font-semibold tracking-tight text-accent">selector4nix</a>

        <nav class="flex items-center gap-1">
          <a
            href="/dashboard/"
            class="inline-flex items-center rounded px-3 py-1.5 text-sm font-medium transition-colors hover:bg-canvas"
            >Overview</a
          >
          <a
            href="/dashboard/transferring"
            class="inline-flex items-center rounded px-3 py-1.5 text-sm font-medium transition-colors hover:bg-canvas"
            >Transferring</a
          >
          <a
            href="/dashboard/cache"
            class="inline-flex items-center rounded px-3 py-1.5 text-sm font-medium transition-colors hover:bg-canvas"
            >Cache</a
          >
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">{% block content %}{% endblock %}</main>
  </body>
</html>
